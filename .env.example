# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
FLASK_ENV=production

# File encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# WebAuthn — must match your domain exactly
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_ORIGIN=https://yourdomain.com

# Email (Gmail SMTP) — needed for email verification
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-gmail-app-password
